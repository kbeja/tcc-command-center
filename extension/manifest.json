{
  "manifest_version": 3,
  "name": "TCC Quick Capture",
  "version": "0.1.0",
  "description": "Quickly capture sparks, keywords, and notes from any page into TCC Command Center.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "TCC Quick Capture",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Open TCC Quick Capture"
    }
  }
}
